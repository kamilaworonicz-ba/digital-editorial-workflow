    <bpmn:textAnnotation id="TextAnnotation_0vaaisk">
      <bpmn:text>Minor changes to printed materials can only be made in June. Major changes can be made every three years.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0232nqa">
      <bpmn:text>Some issues, e.g. experiment videos, are classified as “Other” and may involve the Video Production Company.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ya6pk1" associationDirection="None" sourceRef="Flow_0y75l4h" targetRef="TextAnnotation_0232nqa" />
    <bpmn:textAnnotation id="TextAnnotation_028sd57">
      <bpmn:text>Some issues may fall into both the "digital" and "printed" categories.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_011l526" associationDirection="None" sourceRef="Activity_1mh36hq" targetRef="TextAnnotation_0vaaisk" />
